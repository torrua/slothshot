# ==============================================================================
# SlothShot Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# Google Gemini / Gemma API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Model name to use with the Gemini API (default: gemini-2.5-flash)
GEMMA_MODEL_NAME=gemini-2.5-flash

# Sentry DSN for Agent Tracing telemetry (Optional)
SENTRY_DSN=
ENVIRONMENT=development

# ElevenLabs API Key for voice debriefings (Optional - has offline fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Prior Labs TabPFN API Token (Optional - has Bayesian prior fallback)
TABPFN_TOKEN=
